# --- Base de datos ---
# Conexión de desarrollo. Reemplaza <password> por la clave local del rol.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/ecommerce?schema=public"

# Base de datos separada que usa la suite de tests de integración.
DATABASE_URL_TEST="postgresql://postgres:<password>@localhost:5432/ecommerce_test?schema=public"

# --- Autenticación ---
# Secreto de firma del JWT (HS256). Mínimo 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-de-32-caracteres-o-mas"

# --- Aplicación ---
# URL base para las URLs de redirección de Stripe.
APP_URL="http://localhost:3000"

# --- Stripe ---
# Claves de modo prueba. Deja placeholders si aún no tienes cuenta en Stripe.
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
